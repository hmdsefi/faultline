+		if !held {
+			ls.holder = name
+		}
+		if ls.epochs[name] == 0 {
 			l.epoch++
-			ls.holder, ls.epoch = name, l.epoch
+			ls.epochs[name] = l.epoch
 		}
 		ls.expiry = now.Add(l.TTL)
-		l.W.Net.Send(n, from, Grant{Epoch: ls.epoch, TTL: l.TTL, Sent: req.Sent})
